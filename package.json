    "android:preview": "node scripts/build_android_release.cjs",
    "android:release": "node scripts/build_android_release.cjs --production",
    "backup:supabase": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supabase-backup/backup-supabase.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "prestart": "node scripts/setup_android_reverse.cjs",
    "start": "react-native start",
    "test": "jest",
    "generate:topik64-sql": "node scripts/generate_topik_64_sql.mjs",
    "generate:topik83-sql": "node scripts/generate_topik_83_sql.mjs",
    "generate:topik91-sql": "node scripts/generate_topik_91_sql.mjs",
    "generate:topik102-sql": "node scripts/generate_topik_102_sql.mjs",
    "upload:topik64-assets": "node scripts/upload_topik_96_assets.cjs --manifest backend/sql/seeds/mock_tests/manifests/topik_64_asset_manifest.json",
