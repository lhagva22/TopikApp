    "@react-navigation/bottom-tabs": "7.2.0",
    "@react-navigation/drawer": "7.9.5",
    "@react-navigation/native": "7.1.34",
    "@react-navigation/native-stack": "^7.2.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
