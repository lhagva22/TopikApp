    "react-native-screens": "4.28.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "15.15.5",
    "react-native-vector-icons": "10.3.0",
    "react-native-video": "^6.19.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.3"
