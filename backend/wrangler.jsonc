{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "topikapp-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-21",
  "vars": {
    "CLOUDFLARE_WORKER": "true",
    "NODE_ENV": "production",
    "ENABLE_DEV_PAYMENT_SIMULATION": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
